# NIEresolve Environment Configuration
# Institution: The National Institute of Engineering (NIE), Mysuru

# Application
APP_NAME=NIEresolve
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Security & Authentication
SECRET_KEY=nieresolve-secure-institutional-jwt-key-mysuru-2026-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Configuration (SQLite default for zero-config run, PostgreSQL supported)
DATABASE_URL=sqlite:///./nieresolve.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nieresolve

# File Storage
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=10

# Escalation Policy (in calendar days)
TIER1_ESCALATION_DAYS=15
TIER2_ESCALATION_DAYS=15

# ML & Duplicate Detection
DUPLICATE_SIMILARITY_THRESHOLD=0.65
MODEL_STORAGE_PATH=./backend/app/ml/data/priority_model.joblib
VECTORIZER_STORAGE_PATH=./backend/app/ml/data/tfidf_vectorizer.joblib

# Chatbot & LLM Integration (optional API key, rule-based institutional RAG fallback included)
LLM_PROVIDER=institutional_rag
OPENAI_API_KEY=
GEMINI_API_KEY=

